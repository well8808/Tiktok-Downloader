{
  "name": "tiktok-downloader",
  "version": "0.1.0",
  "private": true,
  "description": "Baixador local de vídeos do TikTok em alta qualidade",
  "author": "well8808",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "reliability": "tsx tests/reliability-suite.ts",
    "bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --win nsis --publish=never"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^6.19.3",
    "@tsparticles/confetti": "^4.0.5",
    "@tsparticles/fireworks": "^4.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.1",
    "lucide-react": "^1.16.0",
    "next": "14.2.35",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.41",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/ui": "^4.1.7",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "get-port-please": "^3.2.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "build": {
    "appId": "com.well8808.tiktokdownloader",
    "productName": "TikTok Downloader",
    "directories": {
      "output": "dist-electron"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      ".next/**/*",
      "!.next/cache/**",
      "public/**/*",
      "lib/**/*",
      "app/**/*",
      "components/**/*",
      "prisma/schema.prisma",
      "prisma/dev.db",
      "next.config.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false,
      "signtoolOptions": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TikTok Downloader",
      "deleteAppDataOnUninstall": false
    }
  }
}
